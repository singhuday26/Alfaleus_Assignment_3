# ─────────────────────────────────────────────────────────────────
# Alfaleus — Environment Configuration Template
# Copy this file to .env and populate with your real credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────
# Full Atlas connection string. For local dev use:
# mongodb://localhost:27017/alfaleus
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alfaleus?retryWrites=true&w=majority
MONGO_DB_NAME=alfaleus

# ── LLM API Keys ─────────────────────────────────────────────────
# Primary: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback: Anthropic Claude
CLAUDE_API_KEY=your-claude-api-key-here

# ── Scraper Configuration ─────────────────────────────────────────
# Maximum pages to crawl per F6S scrape run
F6S_MAX_PAGES=10

# Cron interval in hours for scheduled scrape jobs
SCRAPE_INTERVAL_HOURS=6

# ── Deduplication Engine ──────────────────────────────────────────
# rapidfuzz token_sort_ratio threshold (0-100). Default: 85
FUZZY_THRESHOLD=85

# ── API Security ──────────────────────────────────────────────────
# Secret key for protecting POST /run-scraper endpoint
API_SECRET_KEY=change-me-to-a-strong-random-secret

# ── Application ───────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
